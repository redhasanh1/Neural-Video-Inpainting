# Railway Web Frontend - CPU only (no GPU/CUDA/TensorRT)
# GPU processing happens on local PC via Celery workers

FROM python:3.11-slim

WORKDIR /app

# System dependencies are no longer needed for the lightweight web-only container.
# The worker service handles all processing that requires ffmpeg, etc.

# Copy and install the minimal web-only requirements
COPY requirements_web.txt .
RUN pip install --no-cache-dir -r requirements_web.txt

# Copy only web-related files (cache bust: 2025-12-19-v5)
COPY server_production.py .
COPY email_utils.py .
COPY web ./web
# Apple's root CAs, used to verify StoreKit signed transactions. Without these
# the purchase endpoint fails closed and grants nothing.
COPY certs ./certs

# Create necessary directories
RUN mkdir -p temp uploads results cache

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    RAILWAY=1

# Expose port (Railway uses PORT env var)
EXPOSE 8080

# Run with gunicorn (Railway sets PORT automatically)
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --timeout 120 server_production:app"]
